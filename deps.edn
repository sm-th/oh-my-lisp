;; oml — a Lisp image you run and inhabit.
;;
;; The JVM kernel deliberately depends on nothing beyond Clojure itself;
;; init configuration extends the running image rather than the build.
{:deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {:oml {:main-opts ["-m" "oml.core"]}
           ;; Focused tests:   clojure -M:test -n oml.kernel-test
           ;; All tests:       clojure -M:test
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
