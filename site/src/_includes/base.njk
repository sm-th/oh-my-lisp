<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title if title == "oh-my-lisp" else title + " — oh-my-lisp" %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://oml.sh/">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <script>
    // Applied before first paint so documentation pages never flash the wrong
    // theme. Docs pages toggle and persist this via docs.js; other pages
    // ignore the attribute entirely.
    (function () {
      var root = document.documentElement;
      try {
        var stored = localStorage.getItem("oml-docs-theme");
        var theme = (stored === "light" || stored === "dark") ? stored : "dark";
        root.setAttribute("data-docs-theme", theme);
      } catch (err) {
        root.setAttribute("data-docs-theme", "dark");
      }
    })();
  </script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<nav class="site-nav" aria-label="Primary">
  <a class="nav-brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>oh-my-lisp</a>
  <span class="nav-links">
    <a href="/docs/"{% if page.url.startsWith("/docs/") %} aria-current="page"{% endif %}>Docs</a>
    <a href="https://github.com/sm-th/oh-my-lisp">GitHub</a>
  </span>
</nav>
{{ content | safe }}
</body>
</html>
