<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://oml.sh/">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="site-nav" aria-label="Primary">
  <a class="nav-brand" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>oh-my-lisp</a>
  <span class="nav-links">
    <a href="/docs/"{% if page.url == "/docs/" %} aria-current="page"{% endif %}>Docs</a>
    <a href="/docs/vision/"{% if page.url == "/docs/vision/" %} aria-current="page"{% endif %}>Vision</a>
    <a href="/docs/architecture/"{% if page.url == "/docs/architecture/" %} aria-current="page"{% endif %}>Architecture</a>
    <a href="/docs/acp-architecture/"{% if page.url == "/docs/acp-architecture/" %} aria-current="page"{% endif %}>ACP design</a>
    <a href="/docs/changelog/"{% if page.url == "/docs/changelog/" %} aria-current="page"{% endif %}>Changelog</a>
    <a href="https://github.com/sm-th/oh-my-lisp">GitHub</a>
  </span>
</nav>
{{ content | safe }}
</body>
</html>
