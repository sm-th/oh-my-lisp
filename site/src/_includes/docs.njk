---
layout: base.njk
bodyClass: "docs-page"
---
{%- set doc = content | docsToc %}
<div class="docs-shell{% if not doc.toc.length %} docs-shell--no-toc{% endif %}">
  <aside class="docs-nav" aria-label="Documentation pages">
    <details class="docs-nav-toggle" open>
      <summary class="docs-nav-summary">
        <span>Documentation</span>
        <svg class="docs-nav-summary-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <ul class="docs-nav-list">
        {%- for docPage in collections.docsNav %}
        <li><a href="{{ docPage.url }}"{% if docPage.url == page.url %} aria-current="page"{% endif %}>{{ docPage.data.navTitle }}</a></li>
        {%- endfor %}
      </ul>
    </details>
    <button type="button" class="docs-theme-toggle" data-docs-theme-toggle aria-label="Switch between light and dark theme">
      <span class="docs-theme-toggle-icon" aria-hidden="true">
        <svg class="icon-sun" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.3" fill="currentColor"/><g stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M8 0.5v2.2M8 13.3v2.2M15.5 8h-2.2M2.7 8H0.5M13.2 2.8l-1.6 1.6M4.4 11.6l-1.6 1.6M13.2 13.2l-1.6-1.6M4.4 4.4L2.8 2.8"/></g></svg>
        <svg class="icon-moon" viewBox="0 0 16 16"><path fill="currentColor" d="M14 9.7A6.3 6.3 0 0 1 6.3 2a6.3 6.3 0 1 0 7.7 7.7Z"/></svg>
      </span>
      <span class="docs-theme-toggle-text">
        <span class="label-dark">Dark</span>
        <span class="label-light">Light</span>
      </span>
    </button>
  </aside>

  <article class="docs-content{% if page.url == "/docs/" %} docs-index{% endif %}">
{{ doc.html | safe }}
  </article>

  {% if doc.toc.length %}
  <aside class="docs-toc" aria-label="On this page">
    <p class="docs-toc-heading">On this page</p>
    <ul>
      {%- for item in doc.toc %}
      <li class="docs-toc-item docs-toc-level-{{ item.level }}"><a href="#{{ item.slug }}">{{ item.text }}</a></li>
      {%- endfor %}
    </ul>
  </aside>
  {% endif %}
</div>
<script src="/docs.js" defer></script>
